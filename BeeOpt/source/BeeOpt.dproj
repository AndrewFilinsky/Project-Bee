            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\..\Bee\source\Bee_Assembler.pas"/>
        <DCCReference Include="..\..\Bee\source\Bee_BlowFish.pas"/>
        <DCCReference Include="..\..\Bee\source\Bee_Codec.pas"/>
